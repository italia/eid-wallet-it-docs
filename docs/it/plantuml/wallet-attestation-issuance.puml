@startuml Emissione della Key Attestation
hide footbox

'Participants
actor "User" as user
participant "Wallet Instance" as app
participant "Key Attestation APIs" as kats #springgreen
participant "Device Integrity Service APIs" as aats #springgreen
participant "WSCA/Remote WSCD" as wsca #springgreen
participant "Wallet Provider backend" as bck

user->app: Request a new operation that\nrequires a Key Attestation
activate app

app->app: Verify that Cryptographic Hardware Keys exist\n(""hardware_key_tag""). Otherwise re-initialize

app->app: Verify the Wallet Provider federation membership\nand obtain its metadata

app->bck: Request ""nonce""
activate bck
bck->bck: Generate ""nonce""
bck-->app: ""nonce""
deactivate bck

alt Keys bound to a Digital Credential other than the PID

alt Android

activate kats
app->kats: Generate each Credential key pair\nwith attestation challenge = UTF-8 octets of ""nonce""
kats-->app: ""key_pub"" and ""key_attestation""
deactivate kats

else iOS

app->app: Generate each Credential key pair\nin the Secure Enclave

end

else Keys bound to a PID

app->wsca: Generate each PID key pair in the Remote WSCD
wsca-->app: ""key_pub""

end

app->app: Create ""client_data"" from ""nonce"" and the JWK thumbprints,\nthen ""client_data_hash"" = SHA256(""client_data"")

app->app: ""hardware_signature"" = sign(""client_data_hash"", ""hardware_key_priv"")

alt Keys bound to a Digital Credential other than the PID

alt Android

app->app: ""keys_to_attest"" JWT: ""iat"", ""exp"", ""cnf"",\n""wscd_key_attestation"" (""storage_type"", ""attestation""),\nsigned with ""key_priv""

else iOS

app->aats: ""client_data_hash"" for each key
aats-->app: ""integrity_assertion"" bound to ""client_data_hash""
app->app: ""keys_to_attest"" JWT: ""iat"", ""exp"", ""cnf"",\n""wscd_key_attestation"" (""storage_type"", ""integrity_assertion""),\nsigned with ""key_priv""

end

else Keys bound to a PID

app->app: ""keys_to_attest"" JWT: ""iat"", ""exp"", ""cnf"",\n""wscd_key_attestation"" for the Remote WSCD, without OEM material,\nsigned with ""key_priv""

end

app->app: Key Attestation Request JWT (""ka-request+jwt""):\n""iss"", ""iat"", ""exp"", ""nonce"", ""keys_to_attest"", ""hardware_signature"",\n""hardware_key_tag"", ""cnf"", ""platform"", ""wallet_solution_id"", ""wallet_solution_version""\nsigned with the private key of the first ""cnf""
app->bck: Send ""assertion""
activate bck

bck->bck: Validate the HTTP headers
bck->bck: Validate the request signature with the ""cnf"" ""jwk""
bck->bck: Validate ""nonce"" (issued by the Wallet Provider, unused)
bck->bck: Registered Wallet Instance for ""hardware_key_tag"".\nReject if its Wallet Instance Attestation is revoked
bck->bck: Validate each ""keys_to_attest"" signature with its ""cnf"".\nAndroid: ""attestation"" challenge equals the ""nonce"".\niOS: validate ""integrity_assertion"".\nPID: no OEM material
bck->bck: Reconstruct ""client_data"" and validate ""hardware_signature""
bck->bck: Device meets the Wallet Provider security requirements
bck->bck: ""iss"" matches the Wallet Provider URL identifier
bck->bck: Create Key Attestation

bck-->app: Key Attestation Response
deactivate bck

app->app: Verify the Key Attestation signature and the Issuer trust

deactivate app
@enduml
