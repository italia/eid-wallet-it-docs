@startuml
participant "User" as u

box "User's smartphone" #LightBlue
participant "Browser" as ua
participant "Wallet Instance" as w
end box

participant "Credential Issuer" as i
participant "Trust Infrastructure" as t

/' The diagram starts after the User Request Flow. '/

rnote over w,i #LIGHTGREEN
The Wallet Instance selects exactly one trust path at issuance.

EUDIW: validate the access-certificate-signed Issuer Metadata
and perform EUDIW Authorization.

National: evaluate Federation Entity Authentication and National
Authorization, then obtain the applicable final metadata.
endrnote

alt EUDIW trust path
  w -> i : get signed Credential Issuer Metadata
  i --> w : signed metadata with WRPAC and WRPRC
  w -> t : get Provider of WRPAC and WRPRC LoTEs
  t --> w : LoTE
  w -> w : validate WRPAC path and metadata signature
  w -> w : validate Credential Issuer authorization
else National trust path
  w -> t : resolve Credential Issuer Trust Chain
  t --> w : applicable final metadata and registration Trust Mark
  w -> w : validate Trust Chain and Trust Mark,\nand Credential Issuer authorization
end

opt Batch Credential Issuance
  w -> w : check selected metadata for\nbatch_credential_issuance and batch_size
end

/' Steps 1-2: PAR Request, Authorization Code Grant only '/
w -> w : <b>Step 1</b>\ncreate fresh PKCE code verifier,\nWIA PoP, and state

w -> i : <b>Step 2</b>\nPAR Request (\n  client_id,\n  request,\n  code_challenge,\n  authorization_details and/or scope,\n  state) \nwith OAuth-Client-Attestation and\nOAuth-Client-Attestation-PoP in the Header

i -> t : obtain applicable Wallet Provider trust material\nand WIA status information
t --> i : Wallet Provider Trust Anchor and status result

rnote over i #LIGHTGREEN
Validate the Request Object and Credential identifiers.
Validate the Wallet Provider, WIA signature and certificate
chain, temporal validity, revocation status, and PoP.
Abort issuance if any trust check fails.
endrnote

/' Step 3 '/
i --> w : <b>Step 3</b>\nPAR Response (one-time request_uri, expires_in)

/' Steps 4-5 '/
w --> ua : <b>Step 4</b>\nAuthorization Request (client_id, request_uri)
ua --> i : <b>Step 5</b>\nAuthorization Request (client_id, request_uri)

rnote over i #LIGHTGREEN
The request_uri MUST be present, unexpired, and unused;
it identifies the previously submitted PAR request.
endrnote

alt Credential == PID
  rnote over i,u #WHITE
  Authenticate the User with CieID LoA High (CIE L3)
  and obtain consent, optionally collecting contact details.
  endrnote
else Credential == IT-Wallet ID
  rnote over i,u #WHITE
  Authenticate the User with CieID LoA High (CIE L3) or
  eID Substantial Authentication with MRTD Verification,
  then obtain consent and optionally collect contact details.
  endrnote
else Credential == (Q)EAA
  rnote over i,u #WHITE
  Obtain a valid PID or IT-Wallet ID from the Wallet Instance
  through OpenID4VP, then obtain consent and optionally
  collect contact details.
  endrnote
end

/' Steps 6-7 '/
i --> ua : <b>Step 6</b>\nAuthorization Response (code, state, iss)
ua --> w : <b>Step 7</b>\nAuthorization Response (code, state, iss)
w -> w : validate response parameters, state,\nand intended issuer (iss)

/' Steps 8-11 '/
w -> w : <b>Step 8</b>\ngenerate a fresh DPoP key pair
w -> w : <b>Step 9</b>\ngenerate DPoP proof for the token endpoint

w -> i : <b>Step 10</b>\nToken Request (\n  grant_type=authorization_code,\n  code,\n  code_verifier,\n  redirect_uri) \nwith DPoP proof and\nOAuth-Client-Attestation plus\nOAuth-Client-Attestation-PoP in the Header

i -> t : obtain applicable Wallet Provider trust material\nand WIA status information
t --> i : Wallet Provider Trust Anchor and status result

rnote over i #LIGHTGREEN
Validate the authorization code, its binding to the
authenticated Wallet Instance, redirect_uri, DPoP proof,
and PKCE code_verifier. Repeat the Wallet Provider, WIA
signature and chain, validity, status, and PoP checks.
endrnote

i --> w : <b>Step 11</b>\nToken Response (access_token,\noptional refresh_token, token_type, expires_in)

/' Steps 12-13 '/
w -> i : <b>Step 12</b>\nNonce Request HTTP POST /nonce
i --> w : <b>Step 13</b>\nNonce Response (fresh c_nonce)

/' Steps 14-19 '/
w -> w : <b>Step 14</b>\ncreate DPoP proof for the Credential Endpoint

alt Single Credential Issuance
  w -> w : <b>Step 15</b>\ncreate proof of possession with c_nonce\nusing the DPoP private key
  w -> i : <b>Step 16</b>\nCredential Request with DPoP access token\nand DPoP proof (\n  credential_identifier or credential_configuration_id,\n  proofs (proof1 with Key Attestation))
else Batch Credential Issuance
  w -> w : <b>Step 17</b>\ngenerate N fresh Credential key pairs\n(N == batch_size)
  w -> w : <b>Step 18</b>\ngenerate N key proofs with the same c_nonce
  w -> i : <b>Step 19</b>\nBatch Credential Request with DPoP access token\nand DPoP proof (\n  credential_identifier or credential_configuration_id,\n  proofs (proof1, proof2, ..., proofN with Key Attestations))
end

i -> t : obtain applicable Wallet Provider trust material\nand WIA status information
t --> i : Wallet Provider Trust Anchor and status result

rnote over i #LIGHTGREEN
Validate the DPoP proof, Access Token, and every key proof.
Validate each Key Attestation signature and certificate chain,
validity, status, PoP, and applicable key-protection policy.
The number of issued Credentials MUST equal the number of
key proofs; in a batch, each proof MUST use a unique key.
Register issued credentials for later revocation.
endrnote

/' Steps 20-24 and, when needed, Step 27 '/
alt Credentials immediately available
  i --> w : <b>Step 20</b>\nCredential Response (HTTP 200,\ncredentials, notification_id)
else Deferred issuance
  i --> w : <b>Step 27</b>\nCredential Response (HTTP 202,\ninterval, transaction_id)

  rnote over u,w #WHITE
  Inform the User or wait for the indicated interval.
  The Wallet Instance presents a valid Access Token at the
  Deferred Endpoint. If it expires, use the Refresh Token Flow
  when available; otherwise a new authenticated issuance is needed.
  The same transaction_id retrieves all deferred batch credentials.
  endrnote

  loop Until all requested Credentials are available
    w -> i : <b>Step 27</b>\nDeferred Credential Request (transaction_id)\nwith valid DPoP Access Token
    alt Credentials available
      i --> w : <b>Step 20</b>\nDeferred Credential Response (HTTP 200,\ncredentials, notification_id)
    else Credentials still unavailable
      i --> w : <b>Step 27</b>\nDeferred Credential Response (HTTP 202,\ninterval, transaction_id)
      w -> w : wait for interval or User/local notification
    end
  end
end

w -> t : obtain Credential Issuer\nsignature Trust Anchor 
t --> w : Credential Issuer Trust Anchor
w -> w : <b>Step 21</b>\nvalidate every Credential signature and related trust \nwith signature cryptographic material,\nmandatory response parameters, requested type/schema,\nand format; associate any resolved EDP with each EAA
w -> u : <b>Step 22</b>\nrequest User consent to store Credential(s)
alt User consents to storage
  u --> w : <b>Step 23</b>\nprovide storage consent
  w -> w : <b>Step 24</b>\nsecurely store Credential(s)
else User denies storage
  u --> w : <b>Step 23</b>\ndeny storage consent
end

/' Step 25 '/
w -> i : <b>Step 25</b>\nNotification Request HTTP POST /notification\n(notification_id, event)\nwith DPoP Access Token

rnote over i #LIGHTBLUE
Register all credential-related information needed
for verification and revocation.
For a batch, one notification_id covers the batch;
a partial batch failure fails the batch.
endrnote

/' Step 26 '/
i --> w : <b>Step 26</b>\nNotification Response HTTP 204 No Content
@enduml