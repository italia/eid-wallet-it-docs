@startuml Process Activation Map
left to right direction
skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam packageStyle rectangle
skinparam ArrowColor #666666
skinparam ArrowFontSize 11
skinparam rectangleBorderColor #333333
skinparam roundCorner 8

' =====starting processes =====
rectangle "Entity\nRegistration/Update" as ER #BBDEFB
rectangle "Authentic Source\nRegistration" as ASR #BBDEFB
rectangle "Credential Type\nRegistration/Update" as CTR #C8E6C9

' ===== activated processes =====
package "Trust Artifact Management" as L0 #F5F5F5 {
    rectangle "Registration Trust\nMark Issuance" as TM #FFE0B2
    rectangle "WRPAC Issuance" as WRPAC #FFE0B2
    rectangle "Signature and Seal\nCertificate Issuance" as SS #FFE0B2
    rectangle "WRPRC Issuance" as WRPRC #FFE0B2
    rectangle "National Authentication\nCertificate Issuance" as NAC #FFE0B2
}
package "Registry and Catalog\nManagement" as L1 #F5F5F5 {
    rectangle "Claim\nRegistration" as CR #C8E6C9
    rectangle "Schema\nProvisioning" as SP #C8E6C9
    rectangle "Credential Type Activation\nand Deactivation" as CTA #C8E6C9
}
rectangle "Notification and\nPublication" as NP #E1BEE7

' ===== RIGHT: lifecycle processes =====
rectangle "Entity Suspension\nand Removal" as ESR #BBDEFB
rectangle "Authentic Source\nRemoval" as ASRM #BBDEFB

' --- Entity Registration/Update activations ---
ER --> TM : always
ER --> WRPAC : if WRP
ER --> SS : if issuer or\nWallet Provider
ER --> WRPRC : if WRP
ER --> NAC : if Proximity Flow
ER --> NP : if notified
ER --> CTA : if it completes\na type

' --- Authentic Source Registration activations ---
ASR --> CR : if a claim\nis missing

' --- Credential Type Registration/Update activations ---
CTR --> CR : if a claim\nis missing
CTR --> SP : if a schema\nis missing
CTR --> CTA : if it completes\nthe type

' --- Lifecycle activations ---
ESR --> CTA : if issuer
ESR --> NP : if notified
ASRM --> CTA : if a type\nloses its source

@enduml