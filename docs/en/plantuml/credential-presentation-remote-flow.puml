@startuml
autonumber
Actor "User" as u
box "User's Devices" #LightBlue
participant "Wallet Instance" as w
participant "user-agent" as ua
end box
box "Relying Party" #LightBlue
participant "Relying Party\n(OAuth Client)" as ve
participant "status endpoint" as se
end box

u -> ua: Web Service navigation
ua -> ve: Request Protected Resource
== Presentation Phase ==
ve -> ve: Determine device topology and client_id prefix
alt Cross Device
  ve -> ua: QR page with redirect Authorization Request
  ua -> u: Show QR code
  u -> w: Scan QR code
else Same Device
  ve -> ua: Redirect/href Authorization Request
  ua -> w: Invoke Wallet
end

u -> w: Local User authentication
w -> w: Select exactly one trust path from client_id
alt Redirect flow
  w -> w: Read client_id, request_uri, request_uri_method
  alt request_uri_method=post
    w -> ve: Wallet metadata at request_uri
    ve -> ve: Evaluate Wallet capabilities
  else request_uri_method=get or absent
    w -> ve: GET signed Request Object at request_uri
  end
  ve --> w: Signed Request Object by reference
end

alt x509_hash EUDIW path
  w -> w: Verify WRPAC x5c, leaf hash, and path
  w -> w: Validate WRPRC
  w -> w: Validate signed Request Object with WRPAC key
else openid_federation National path
  w -> w: Validate Trust Chain and final metadata
  w -> w: Validate registration-entity Trust Mark
  w -> w: Verify signed Request Object with kid metadata key
end
w -> w: Validate identity, metadata, endpoints and exact DCQL scope
w -> w: Validate presentation authorization
w -> u: Display verified RP/Service and requested data and/or request override
u --> w: Consent/Override

w -> ve: Encrypted Authorization Response (direct_post.jwt)
ve -> ve: Validate presentation and independent Credential Issuer trust
ve -> ve: Check Cerdential siganture using the trusted Credential Issuer's key, \nHolder Key Binding using the public key in the Credential to verify \nthe Proof of possession.
ve -> ve: Update User session (cookie updated)

alt Same Device redirect
  ve --> w: HTTP/1.1 200 OK\n {"redirect_uri": https url with response_code }
  w -> ua: Follow redirect_uri
else Cross Device redirect
  ve --> w: HTTP/1.1 200 OK
  ua -> se: JavaScript check: authentication state \n (HTTP request with cookie)
  se --> ua: HTTP/1.1 200 OK\n {"redirect_uri": https url with response_code}
end
ve --> ua: Protected resource
@enduml